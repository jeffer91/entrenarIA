{
  "name": "entrenaria",
  "version": "1.0.0",
  "private": true,
  "description": "Evaluación académica con memoria de correcciones validadas",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base=./",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "postinstall": "node scripts/install-electron.cjs"
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "vite": "8.3.5"
  }
}
